# ─── Daily Planner configuration ────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you have. Every section is
# optional — any source you leave blank is simply skipped, and the planner runs
# with whatever it can gather.

# ── Identity / locale ───────────────────────────────────────────────────────
USER_NAME=Edwin
CITY=Nairobi
TIMEZONE=Africa/Nairobi

# ── Claude (required for the plan to be generated) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-4-8
CLAUDE_MODEL=claude-opus-4-8

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# For Gmail: host=smtp.gmail.com port=465, and use an App Password (not your
# normal password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=you@gmail.com

# ── WhatsApp (CallMeBot, free) ──────────────────────────────────────────────
# One-time setup: add +34 644 75 95 78 to your contacts, then WhatsApp it
#   "I allow callmebot to send me messages"
# It replies with your personal API key. Details: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=+254700000000
CALLMEBOT_APIKEY=123456

# ── UrbanTrends (your project's task feed) ──────────────────────────────────
# An HTTP(S) endpoint that returns JSON. Leave blank to skip.
# Expected shape: a JSON array of objects, or {"tasks": [...]}, each with
# fields like {"title": "...", "due": "...", "priority": "...", "status": "..."}
URBANTRENDS_API_URL=
URBANTRENDS_API_TOKEN=

# ── Local tasks file ────────────────────────────────────────────────────────
# A markdown / plain-text todo list you maintain. Defaults to ./tasks.md
TASKS_FILE=tasks.md

# ── News brief (RSS) ────────────────────────────────────────────────────────
# Comma-separated RSS feed URLs. Defaults to a couple of tech/world feeds.
NEWS_FEEDS=https://feeds.arstechnica.com/arstechnica/index,https://feeds.bbci.co.uk/news/world/rss.xml
NEWS_MAX_ITEMS=6
