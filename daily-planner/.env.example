# ─── Daily Planner configuration ────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you have. Every section is
# optional — any source you leave blank is simply skipped, and the planner runs
# with whatever it can gather.

# ── Identity / locale ───────────────────────────────────────────────────────
USER_NAME=Edwin
CITY=Nairobi
TIMEZONE=Africa/Nairobi

# ── Claude (required for the plan to be generated) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# ── Email (Resend HTTP API) ─────────────────────────────────────────────────
# Get an API key at https://resend.com/api-keys
RESEND_API=re_your_key_here
# Sender. Default onboarding@resend.dev works with no setup, but only delivers
# to your own Resend account email. To send anywhere, verify a domain and set
# EMAIL_FROM to an address on it, e.g. planner@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=you@example.com

# ── WhatsApp (CallMeBot, free) ──────────────────────────────────────────────
# One-time setup: add +34 644 75 95 78 to your contacts, then WhatsApp it
#   "I allow callmebot to send me messages"
# It replies with your personal API key. Details: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=+254700000000
CALLMEBOT_APIKEY=123456

# ── UrbanTrends (your project's task feed) ──────────────────────────────────
# An HTTP(S) endpoint that returns JSON. Leave blank to skip.
# Expected shape: a JSON array of objects, or {"tasks": [...]}, each with
# fields like {"title": "...", "due": "...", "priority": "...", "status": "..."}
URBANTRENDS_API_URL=
URBANTRENDS_API_TOKEN=

# ── Local tasks file ────────────────────────────────────────────────────────
# A markdown / plain-text todo list you maintain. Defaults to ./tasks.md
TASKS_FILE=tasks.md

# ── This computer (local context) ───────────────────────────────────────────
# Pull context off the machine the planner runs on. All optional; leave blank
# to skip. `~` is expanded.
#
# Files & folders, comma-separated. A file's contents are read (size-capped);
# a folder contributes the list of files changed recently (see LOCAL_RECENT_DAYS).
LOCAL_CONTEXT_PATHS=~/notes/today.md,~/Desktop,~/Documents/standup.md
# Git repos, comma-separated. Each adds the last few days of commit subjects,
# so "what did I work on yesterday" lands in the plan automatically.
LOCAL_GIT_REPOS=~/Developer/Sandbox/agentic-ai
# Max bytes read from any single file (default 4000).
LOCAL_MAX_FILE_BYTES=4000
# Lookback window for folder changes and git commits, in days (default 2).
LOCAL_RECENT_DAYS=2

# ── Calendar writing (schedule the plan) ────────────────────────────────────
# When true, the planner writes Claude's time-blocked schedule (focus blocks,
# meetings, client calls) to your Google Calendar. Needs calendar auth set up
# (see README → Google Calendar). Off by default; --schedule does the same for a
# manual run. Existing identical events are skipped, so daily re-runs are safe.
SCHEDULE_EVENTS=false

# ── News brief (RSS) ────────────────────────────────────────────────────────
# Comma-separated RSS feed URLs. Defaults to a couple of tech/world feeds.
NEWS_FEEDS=https://feeds.arstechnica.com/arstechnica/index,https://feeds.bbci.co.uk/news/world/rss.xml
NEWS_MAX_ITEMS=6

# ── Web UI auth ──────────────────────────────────────────────────────────────
# Random signing key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
APP_USER=edwin
# Login password — set it with:  python set_password.py  (stores a base64 hash)
APP_PASSWORD_HASH_B64=
# Set to true in production (served over HTTPS) so the session cookie is Secure.
COOKIE_SECURE=false
