# ─── Mica agent service configuration ───────────────────────────────────────
# Copy to `.env` and fill in. Sensible local defaults let the loop run on
# SQLite with no external services; the production stack reads the same vars.

# ── Django core ─────────────────────────────────────────────────────────────
# Random signing key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────────────────────
# Leave blank for local SQLite. In Docker/production set a Postgres URL, e.g.
#   postgres://mica:password@db:5432/mica
DATABASE_URL=

# ── Redis (session state, rate limits, Celery broker) ───────────────────────
# Optional for P1. Used from P2/P6 onward.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Claude (Anthropic API, tool use) ────────────────────────────────────────
# Leave blank to run the loop with the deterministic stub planner (no cost,
# useful for tests + the P1 gate). Set the key to switch to real Claude tool use.
ANTHROPIC_API_KEY=
# Routing/classification model (cheap) and the conversation model.
CLAUDE_ROUTER_MODEL=claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6
# Hard cap on tool-selection turns per user message (loop safety valve).
AGENT_MAX_STEPS=4

# ── Host-site identity (login) ──────────────────────────────────────────────
# Mika verifies the visitor's urbantrends.dev login instead of authenticating
# anyone herself. "stub" is keyless (dev/tests): it trusts an X-UT-Identity
# header so flows can exercise a signed-in visitor. "allauth" introspects the
# host site's headless allauth session endpoint at ALLAUTH_BASE_URL.
IDENTITY_BACKEND=stub
ALLAUTH_BASE_URL=
