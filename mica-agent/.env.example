# ─── Mica agent service configuration ───────────────────────────────────────
# Copy to `.env` and fill in. Sensible local defaults let the loop run on
# SQLite with no external services; the production stack reads the same vars.

# ── Django core ─────────────────────────────────────────────────────────────
# Random signing key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: HTTPS origins trusted for CSRF (admin/API POSTs behind Caddy).
# Comma-separated, scheme included, e.g. https://agent.urbantrends.dev
CSRF_TRUSTED_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
# Leave blank for local SQLite. In Docker/production set a Postgres URL, e.g.
#   postgres://mica:password@db:5432/mica
DATABASE_URL=

# ── Redis (session state, rate limits, Celery broker) ───────────────────────
# Optional for P1. Used from P2/P6 onward.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Claude (Anthropic API, tool use) ────────────────────────────────────────
# Leave blank to run the loop with the deterministic stub planner (no cost,
# useful for tests + the P1 gate). Set the key to switch to real Claude tool use.
ANTHROPIC_API_KEY=
# Routing/classification model (cheap) and the conversation model.
CLAUDE_ROUTER_MODEL=claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6
# Hard cap on tool-selection turns per user message (loop safety valve).
AGENT_MAX_STEPS=4

# ── Host-site identity (login) ──────────────────────────────────────────────
# Mika verifies the visitor's urbantrends.dev login instead of authenticating
# anyone herself. "stub" is keyless (dev/tests): it trusts an X-UT-Identity
# header so flows can exercise a signed-in visitor. "allauth" introspects the
# host site's headless allauth session endpoint at ALLAUTH_BASE_URL.
IDENTITY_BACKEND=stub
ALLAUTH_BASE_URL=

# ── UrbanTrends backend (agent_api — BACKEND_APIS.md) ────────────────────────
# Set URBANTRENDS_API_BASE to source catalog + pricing + orders from the live
# backend. Bare origin — the client adds the /api/v1/agent prefix itself. Leave
# blank to run on the in-repo static stubs (keyless dev/tests). On the shared box,
# reach the backend by its compose service alias on the shared network, e.g.
#   http://backend:8000                 (shared docker network alias)   or
#   https://urbantrends.dev
# (Confirm the alias with `docker inspect <backend-container> -f
# '{{json .NetworkSettings.Networks}}'` → look at DNSNames/Aliases; the backend
# resolves as `backend` / `urbantrends-backend-1`, NOT `urbantrends-backend`.)
URBANTRENDS_API_BASE=
# Service credential (Mica → backend). Sent as "<PREFIX><key>" in <HEADER>.
# Defaults (unset below) give `Authorization: Bearer <key>`. For a custom scheme
# uncomment and set, e.g. URBANTRENDS_API_KEY_HEADER=X-Agent-Key with an empty
# prefix (note: setting PREFIX blank here yields no prefix, not the default).
URBANTRENDS_API_KEY=
# URBANTRENDS_API_KEY_HEADER=X-Agent-Key
# URBANTRENDS_API_KEY_PREFIX=
URBANTRENDS_API_TIMEOUT=4
# Docker only: the backend's existing docker network that web/worker join so
# they can reach it by service name (see docker-compose.yml). Find it with
# `docker network ls` — usually <backend-compose-project>_default. Not needed if
# URBANTRENDS_API_BASE points at a public URL (https://urbantrends.dev).
URBANTRENDS_NETWORK=urbantrends_default
