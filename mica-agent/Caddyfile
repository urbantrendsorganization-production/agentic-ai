# Caddyfile — host Caddy config for the Mica agent service.
#
# Mica runs in docker compose with `web` bound to 127.0.0.1:8002 (host 8000 is
# taken by urbantrends-backend). Host Caddy terminates TLS and proxies to it,
# and sets X-Forwarded-Proto, which settings.py trusts (SECURE_PROXY_SSL_HEADER).
# Static assets (admin, widget) are served by WhiteNoise from gunicorn, so Caddy
# just proxies through — no separate static handling.
#
# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDED — same-origin mount. Add this INSIDE the existing urbantrends.dev
# site block in your host Caddyfile, ABOVE the catch-all reverse_proxy to the
# frontend. `handle_path` strips the /agent prefix, so Mica sees /api/... as
# normal, and the visitor's urbantrends.dev `sessionid` cookie flows through
# untouched (agent/identity.py depends on this).
#
#   urbantrends.dev {
#       # ... existing routes (frontend :3000, backend :8000) ...
#
#       # Mica agent — same-origin, so the session cookie reaches her.
#       handle_path /agent/* {
#           reverse_proxy 127.0.0.1:8002 {
#               health_uri /api/health/
#               health_interval 15s
#               health_timeout 5s
#           }
#       }
#   }
#
# Then embed the widget on the site pointing at the mounted API base:
#   <script src="https://cdn.../mika-widget.js" data-api-base="/agent/api"></script>
# (The widget defaults to location.origin + "/api"; the /agent prefix routes it
# to Mica instead of the urbantrends backend.)
#
# ─────────────────────────────────────────────────────────────────────────────
# ALTERNATIVE — dedicated subdomain (only if a same-origin mount isn't possible;
# needs CORS + CSRF_TRUSTED_ORIGINS + a shared cookie domain to pass the session).
# Uncomment to use standalone:
#
# agent.urbantrends.dev {
# 	encode gzip zstd
# 	reverse_proxy 127.0.0.1:8002 {
# 		health_uri /api/health/
# 		health_interval 15s
# 		health_timeout 5s
# 	}
# 	log {
# 		output file /var/log/caddy/mica-access.log
# 	}
# }
