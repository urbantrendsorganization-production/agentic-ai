# Caddyfile — TLS termination + reverse proxy for the Mica agent service.
#
# Runs on the Hetzner host, in front of the docker compose stack. `web` binds
# 127.0.0.1:8000 (see docker-compose.yml), so only Caddy is publicly exposed.
# Caddy auto-provisions and renews a Let's Encrypt certificate for the domain
# and sets X-Forwarded-Proto, which settings.py trusts (SECURE_PROXY_SSL_HEADER).
#
# Static assets (admin, widget) are served by WhiteNoise from within gunicorn,
# so Caddy just proxies everything through — no separate static handling here.
#
# Topology note: the clean design is same-origin — the urbantrends.dev site
# proxies /agent/* to this service so the visitor's `sessionid` cookie flows
# through untouched (see agent/identity.py). This file covers the standalone
# subdomain case; for a path-based mount, put the `reverse_proxy` inside the
# site's own Caddy/proxy config under a `handle_path /agent/*` block instead.

agent.urbantrends.dev {
	encode gzip zstd

	reverse_proxy 127.0.0.1:8000 {
		# Passive health-check against the agent's health endpoint.
		health_uri /api/health/
		health_interval 15s
		health_timeout 5s
	}

	log {
		output file /var/log/caddy/mica-access.log
	}
}
